# Copy this file to .env and replace the placeholders before starting the deployment.
# Never commit a real .env file or real credentials.

# Required: signs browser sessions so they survive container restarts.
MEDIA_RECOMMENDER_WEB_SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional: default streaming-availability region (ISO 3166-1 alpha-2).
MEDIA_RECOMMENDER_DEFAULT_REGION=CZ

# Optional: application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
MEDIA_RECOMMENDER_LOG_LEVEL=INFO

# Optional provider configuration. Uncomment and replace the placeholders to enable a provider.
# MEDIA_RECOMMENDER_TMDB_API_TOKEN=replace-with-tmdb-api-read-access-token
# MEDIA_RECOMMENDER_JELLYFIN_BASE_URL=https://jellyfin.example.invalid/
# MEDIA_RECOMMENDER_JELLYFIN_API_TOKEN=replace-with-jellyfin-api-key
# MEDIA_RECOMMENDER_JELLYFIN_USER_ID=replace-with-jellyfin-user-id
